# AI Stock Advisor Environment Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (for AI investment advisory & reports)
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API Key (for real-time stock news & web search)
# Get one from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Finnhub API Key (for global stock metrics, peers & news)
# Get one from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# TwelveData API Key (for financial market data)
# Get one from: https://twelvedata.com/
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Application Settings
DEFAULT_START_DATE=2015-01-01
SQLITE_DB_PATH=data/indian_stock_market.sqlite

